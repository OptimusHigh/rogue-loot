                  "{\"text\": \" \", \"italic\": false}",
                  "{\"text\": \"\\u00a7e\\u2726 \\u0421\\u0432\\u043e\\u0439\\u0441\\u0442\\u0432\\u043e: \\u00a7f\\u041d\\u043e\\u0447\\u043d\\u043e\\u0435 \\u0437\\u0440\\u0435\\u043d\\u0438\\u0435 \\u0438 \\u0438\\u043c\\u043c\\u0443\\u043d\\u0438\\u0442\\u0435\\u0442 \\u043a \\u0442\\u0435\\u043c\\u043d\\u043e\\u0442\\u0435\", \"italic\": false}",
                  "{\"text\": \"\\u00a7e\\u2726 \\u0422\\u0435\\u043f\\u043b\\u043e\\u0432\\u0438\\u0437\\u043e\\u0440: \\u00a7f\\u041f\\u043e\\u0434\\u0441\\u0432\\u0435\\u0447\\u0438\\u0432\\u0430\\u0435\\u0442 \\u043c\\u043e\\u043d\\u0441\\u0442\\u0440\\u043e\\u0432 \\u0432\\u043e\\u043a\\u0440\\u0443\\u0433 \\u0441\\u043a\\u0432\\u043e\\u0437\\u044c \\u0441\\u0442\\u0435\\u043d\\u044b\", \"italic\": false}",
